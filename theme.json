					"slug": "surface"
				},
				{
					"color": "#ddca91",
					"name": "Alternate Surface",
					"slug": "surface-alt"
				},
				{
					"color": "#28251f",
					"name": "Foreground",
					"slug": "foreground"
				},
				{
					"color": "#655f54",
					"name": "Muted Text",
					"slug": "text-muted"
				},
				{
					"color": "#b8aa8e",
					"name": "Border",
					"slug": "border-subtle"
				},
				{
					"color": "#f4e3e8",
					"name": "Primary 100",
					"slug": "primary-100"
				},
				{
					"color": "#c77b90",
