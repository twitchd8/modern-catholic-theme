				},
				{
					"color": "#5d172a",
					"name": "Primary 700",
					"slug": "primary-700"
				},
				{
					"color": "#35101b",
					"name": "Primary 900",
					"slug": "primary-900"
				},
				{
					"color": "#e4ebe6",
					"name": "Secondary 100",
					"slug": "secondary-100"
				},
				{
					"color": "#9eb0a3",
					"name": "Secondary 300",
					"slug": "secondary-300"
				},
				{
					"color": "#52695b",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#3d5045",
					"name": "Secondary 700",
					"slug": "secondary-700"
				},
				{
					"color": "#26342c",
					"name": "Secondary 900",
					"slug": "secondary-900"
				},
				{
					"color": "#f7efd8",
					"name": "Accent 100",
					"slug": "accent-100"
				},
				{
					"color": "#dec67f",
					"name": "Accent 300",
					"slug": "accent-300"
				},
				{
					"color": "#a17b28",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#72571c",
					"name": "Accent 700",
					"slug": "accent-700"
				},
				{
					"color": "#43330f",
					"name": "Accent 900",
					"slug": "accent-900"
				},
				{
					"color": "#fffaf0",
					"name": "On Primary",
					"slug": "on-primary"
				},
				{
					"color": "#fffaf0",
					"name": "On Secondary",
					"slug": "on-secondary"
				},
				{
					"color": "#0f0d09",
					"name": "On Accent",
					"slug": "on-accent"
				},
				{
					"color": "#ffffff",
					"name": "On Image",
					"slug": "on-image"
				},
				{
					"color": "#1b1714",
					"name": "Image Scrim",
					"slug": "scrim"
				}
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "75rem"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"background": {
			"backgroundImage": {
				"url": "file:./assets/images/textured-paper.png"
			},
			"backgroundPosition": "50% 0",
			"backgroundRepeat": "repeat",
			"backgroundSize": "auto"
		},
		"color": {
			"background": "var:preset|color|canvas",
			"text": "var:preset|color|foreground"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|on-primary"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|foreground"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				}
			}
		},
		"spacing": {
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		},
		{
			"area": "uncategorized",
			"name": "parish-mass-times",
			"title": "Parish Mass Times"
		},
		{
			"area": "uncategorized",
			"name": "parish-life-links",
			"title": "Parish Life Links"
		}
	]
}
