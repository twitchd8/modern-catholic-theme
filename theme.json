{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#f4eedc",
					"name": "Almandine Ivory",
					"slug": "almandine"
				},
				{
					"color": "#d9c68f",
					"name": "Barley Gold",
					"slug": "barley"
				},
				{
					"color": "#66796c",
					"name": "Mountain Moss",
					"slug": "mountain-moss"
				},
				{
					"color": "#7a2038",
					"name": "Sanctuary Burgundy",
					"slug": "sanctuary-burgundy"
				},
				{
					"color": "#28251f",
					"name": "Ink",
					"slug": "black"
				},
				{
					"color": "#ffffff",
					"name": "White",
					"slug": "white"
				}
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "75rem"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|almandine",
			"text": "var:preset|color|black"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|sanctuary-burgundy",
					"text": "var:preset|color|white"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|black"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|sanctuary-burgundy"
				}
			}
		},
		"spacing": {
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		},
		{
			"area": "uncategorized",
			"name": "todays-readings",
			"title": "Today’s Readings"
		},
		{
			"area": "uncategorized",
			"name": "parish-mass-times",
			"title": "Parish Mass Times"
		},
		{
			"area": "uncategorized",
			"name": "parish-life-links",
			"title": "Parish Life Links"
		}
	]
}
