{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#e9e2d4",
					"name": "Canvas",
					"slug": "canvas"
				},
				{
					"color": "#f7f1e2",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#ebdcd1",
					"name": "Alternate Surface",
					"slug": "surface-alt"
				},
				{
					"color": "#28251f",
					"name": "Foreground",
					"slug": "foreground"
				},
				{
					"color": "#6a665d",
					"name": "Muted Text",
					"slug": "text-muted"
				},
				{
					"color": "#c5c0b3",
					"name": "Border",
					"slug": "border-subtle"
				},
				{
					"color": "#e8d8ce",
					"name": "Primary 100",
					"slug": "primary-100"
				},
				{
					"color": "#c8a2a1",
					"name": "Primary 300",
					"slug": "primary-300"
				},
				{
					"color": "#7a2038",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#682133",
					"name": "Primary 700",
					"slug": "primary-700"
				},
				{
					"color": "#58222e",
					"name": "Primary 900",
					"slug": "primary-900"
				},
				{
					"color": "#e3e1d2",
					"name": "Secondary 100",
					"slug": "secondary-100"
				},
				{
					"color": "#b8bdaf",
					"name": "Secondary 300",
					"slug": "secondary-300"
				},
				{
					"color": "#52695b",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#495a4e",
					"name": "Secondary 700",
					"slug": "secondary-700"
				},
				{
					"color": "#404c42",
					"name": "Secondary 900",
					"slug": "secondary-900"
				},
				{
					"color": "#ede3cc",
					"name": "Accent 100",
					"slug": "accent-100"
				},
				{
					"color": "#d6c49b",
					"name": "Accent 300",
					"slug": "accent-300"
				},
				{
					"color": "#a17b28",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#866826",
					"name": "Accent 700",
					"slug": "accent-700"
				},
				{
					"color": "#6e5724",
					"name": "Accent 900",
					"slug": "accent-900"
				},
				{
					"color": "#fffaf0",
					"name": "On Primary",
					"slug": "on-primary"
				},
				{
					"color": "#fffaf0",
					"name": "On Secondary",
					"slug": "on-secondary"
				},
				{
					"color": "#0f0d09",
					"name": "On Accent",
					"slug": "on-accent"
				},
				{
					"color": "#ffffff",
					"name": "On Image",
					"slug": "on-image"
				},
				{
					"color": "#28251f",
					"name": "Image Scrim",
					"slug": "scrim"
				}
			],
			"gradients": [
				{
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--surface) 0%, var(--wp--preset--color--surface-alt) 100%)",
					"name": "Quiet Surface",
					"slug": "quiet-surface"
				},
				{
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary-900) 0%, var(--wp--preset--color--primary) 100%)",
					"name": "Primary Depth",
					"slug": "primary-depth"
				},
				{
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary-700) 0%, var(--wp--preset--color--secondary) 100%)",
					"name": "Sacred Contrast",
					"slug": "sacred-contrast"
				},
				{
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--accent-100) 0%, var(--wp--preset--color--accent) 100%)",
					"name": "Gilded Accent",
					"slug": "gilded-accent"
				}
			],
			"duotone": [
				{
					"colors": [
						"#58222e",
						"#e8d8ce"
					],
					"name": "Primary Wash",
					"slug": "primary-wash"
				},
				{
					"colors": [
						"#58222e",
						"#d6c49b"
					],
					"name": "Primary and Gold",
					"slug": "primary-gold"
				},
				{
					"colors": [
						"#404c42",
						"#e3e1d2"
					],
					"name": "Secondary Wash",
					"slug": "secondary-wash"
				},
				{
					"colors": [
						"#28251f",
						"#f7f1e2"
					],
					"name": "Ink and Parchment",
					"slug": "ink-parchment"
				}
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "75rem"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"background": {
			"backgroundImage": {
				"url": "file:./assets/images/textured-paper.png"
			},
			"backgroundPosition": "50% 0",
			"backgroundRepeat": "repeat",
			"backgroundSize": "auto"
		},
		"color": {
			"background": "var:preset|color|canvas",
			"text": "var:preset|color|foreground"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|on-primary"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|foreground"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				}
			}
		},
		"spacing": {
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		},
		{
			"area": "uncategorized",
			"name": "parish-mass-times",
			"title": "Parish Mass Times"
		},
		{
			"area": "uncategorized",
			"name": "parish-life-links",
			"title": "Parish Life Links"
		}
	]
}
